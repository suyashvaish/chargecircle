# ChargeCircle - LOCAL DEVELOPMENT configuration template (placeholders only, safe to commit).
# Copy to backend/.env for local work.  For production use .env.production.example instead.

ENVIRONMENT=development
DEBUG=false
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (SQLite for quick local work; PostgreSQL/PostGIS for anything else)
DATABASE_URL=sqlite:///./chargecircle.db
AUTO_CREATE_TABLES=true          # development convenience only; production uses `alembic upgrade head`

# Security: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me-generate-a-random-value-of-at-least-32-characters
# Used only by scripts/seed_data.py to create the first admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-seeding

# Listings are auto-approved ONLY when this is true and ENVIRONMENT is not production
AUTO_APPROVE_LISTINGS=true

# Public station data (Open Charge Map). Get a free key at https://openchargemap.org/site/develop/api
USE_LIVE_CHARGER_FEED=false
OCM_API_KEY=

# Routing (optional). Without it, distance/time are not shown and navigation uses Google/Apple Maps links.
ROUTING_PROVIDER=none            # none | openrouteservice
ORS_API_KEY=

# Payments: mock = local test payments only (refused in production); razorpay = real API
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email: console prints emails to the server log (development only); smtp sends real mail
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=support@example.com

# Frontend (frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
